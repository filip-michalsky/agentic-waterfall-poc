# ---- Soap (tier zero, SANDBOX only) ----
SOAP_API_URL=https://api-sandbox.paywithsoap.com
SOAP_API_KEY=

# ---- Basis Theory (TEST tenant only; the orchestrator refuses any other host) ----
BT_API_URL=https://api.test.basistheory.com
BT_TEST_PRIVATE_KEY=            # private app: token:create, token:read, token:use
BT_TEST_MANAGEMENT_KEY=         # management app: reactor:create, reactor:read — only used once to create the reveal reactor
BT_REVEAL_REACTOR_ID=           # filled after `npm run bt:reactor`

# ---- Browser agent ----
STAGEHAND_ENV=LOCAL             # LOCAL | BROWSERBASE
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
STAGEHAND_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HEADFUL=0                       # 1 = show the local Chromium

# ---- Opt-in public sandbox broadcast (run --broadcast) ----
LIVE_DEMO_URL=https://soap-agentic-waterfall-demo.vercel.app
LIVE_BROADCAST_SECRET=           # same server-only secret on the runner and Vercel

# ---- Demo deploy (manual, from ./demo) ----
VERCEL_SCOPE=                   # your Vercel team/user slug
VERCEL_PROJECT=                 # e.g. my-agentic-waterfall-demo

# ---- Storefronts (the "UI-only merchants") ----
STOREFRONT_PORT=4321
STOREFRONT_URL=http://localhost:4321   # must be reachable by the browser session (ngrok/Vercel when BROWSERBASE)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
ADYEN_API_KEY=
ADYEN_CLIENT_KEY=
ADYEN_MERCHANT_ACCOUNT=
CKO_SECRET_KEY=
CKO_PUBLIC_KEY=
CKO_PROCESSING_CHANNEL_ID=

# ---- API-authorization tiers (card carried via BT ephemeral Proxy / Liquid) ----
# These tiers authorize server-to-server: the PAN is never revealed in-process;
# only Liquid placeholders ({{ token: <id> | json: '$.data.number' }}) are sent,
# and Basis Theory detokenizes them before forwarding to the provider.
# adyen-api reuses ADYEN_API_KEY + ADYEN_MERCHANT_ACCOUNT above.
ADYEN_CHECKOUT_API=https://checkout-test.adyen.com/v71
# checkout-com-api reuses CKO_SECRET_KEY (sk_sbox_…, NOT the pk_ public key) above.
CKO_API_BASE=https://api.sandbox.checkout.com
# --simulate-decline checkout-com-api injects a labelled, provider-free decline.
# Amount-based experiments did not decline the fixed test PAN (2026-09-07).
# There is no stripe-api tier: raw-card API access was unavailable for this
# sandbox account. The `stripe` tier uses Stripe.js hosted fields instead.

# ---- Whop sandbox (external hosted checkout) ----
WHOP_SANDBOX_API_KEY=
WHOP_SANDBOX_PLAN_ID=
WHOP_TEST_EMAIL=                # real mailbox for the sandbox checkout; Whop checks MX records and rejects example.com
WHOP_API_URL=https://sandbox-api.whop.com/api/v1
